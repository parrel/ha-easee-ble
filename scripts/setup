#!/usr/bin/env bash
# One-time devcontainer provisioning: Home Assistant plus the easee-ble library.
set -euo pipefail
cd "$(dirname "$0")/.."

python3 -m pip install --upgrade pip
# pytest-homeassistant-custom-component pins the Home Assistant it was built against.
pip install -r requirements-test.txt
# The library plus the Home Assistant integration requirements the tests import.
# easee-ble comes from PyPI at the manifest's pin, exactly as Home Assistant installs it.
pip uninstall -y easee-ble >/dev/null 2>&1 || true
scripts/install-deps

echo "Setup complete. Run scripts/develop to start Home Assistant, or pytest."
