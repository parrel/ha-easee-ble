#!/usr/bin/env bash
# Start Home Assistant against ./config with this integration linked in.
set -euo pipefail
cd "$(dirname "$0")/.."

mkdir -p config

if [ ! -f config/configuration.yaml ]; then
    cat > config/configuration.yaml <<'YAML'
default_config:

logger:
  default: info
  logs:
    custom_components.easee_ble: debug
    easee_ble: debug
YAML
fi

# One symlink for the directory, so new platform files need no further wiring.
ln -sfn "$PWD/custom_components" config/custom_components

# Home Assistant reinstalls any requirement whose installed version is not the
# pinned one, which would silently replace a local checkout of the library.
PACKAGE="$(python3 -c 'import json, re; print(re.split(r"[=<>!~ \[]", json.load(open("custom_components/easee_ble/manifest.json"))["requirements"][0])[0])')"

exec hass --config config --debug --skip-pip-packages "$PACKAGE" "$@"
