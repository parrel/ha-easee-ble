  "exceptions": {
    "not_in_range": {
      "message": "Charger {serial} ({address}) is not in range or not advertising."
    },
    "command_refused": {
      "message": "Charger {serial} refused the command: {error}"
    },
    "command_failed": {
      "message": "The command could not be delivered to charger {serial}: {error}"
    },
    "command_timeout": {
      "message": "Charger {serial} did not respond within {timeout} seconds. The connection was dropped and will be re-established automatically."
    },
    "not_an_easee_charger": {
      "message": "Device {device_id} is not an Easee charger from this integration."
    },
    "charger_not_loaded": {
      "message": "That charger's configuration entry is not loaded. Enable it and try again."
    }
  },
  "services": {
    "list_rfid_keys": {
      "name": "List RFID keys",
      "description": "Lists the keys enrolled on the charger itself. These work without a network; tags paired through the Easee app live in the cloud and are not listed here.",
      "fields": {
        "device_id": {
          "name": "Charger",
          "description": "The charger to act on."
        }
      }
    },
    "add_rfid_key": {
      "name": "Add RFID key",
      "description": "Enrols a key on the charger under a name.",
      "fields": {
        "device_id": {
          "name": "Charger",
          "description": "The charger to act on."
        },
        "name": {
          "name": "Name",
          "description": "The name to enrol the key under."
        },
        "token": {
          "name": "Token",
          "description": "The tag's UID, in hex - the token the key is enrolled under."
        }
      }
    },
    "remove_rfid_key": {
      "name": "Remove RFID key",
      "description": "Removes an enrolled key from the charger.",
      "fields": {
        "device_id": {
          "name": "Charger",
          "description": "The charger to act on."
        },
        "token": {
          "name": "Token",
          "description": "The tag's UID, in hex - the token the key is enrolled under."
        }
      }
    }
  }
