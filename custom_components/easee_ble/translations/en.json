{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Easee charger",
        "description": "Select the charger to add. It must be advertising (chargers advertise for ~10 minutes after a reboot or a long press of the touch button, unless Bluetooth is kept on).",
        "data": {
          "address": "Charger"
        },
        "data_description": {
          "address": "Chargers advertise their serial number as their Bluetooth name."
        }
      },
      "pin": {
        "title": "Enter the PIN",
        "description": "Enter the PIN printed on charger {serial}.",
        "data": {
          "pin": "PIN"
        },
        "data_description": {
          "pin": "The PIN printed on the label on the underside of the charger."
        }
      },
      "reauth_confirm": {
        "title": "Re-enter the PIN",
        "description": "Charger {serial} rejected the stored PIN. Enter the PIN printed on the charger.",
        "data": {
          "pin": "PIN"
        },
        "data_description": {
          "pin": "The PIN printed on the label on the underside of the charger."
        }
      }
    },
    "abort": {
      "already_configured": "This charger is already configured.",
      "no_devices_found": "No Easee chargers are advertising right now.",
      "no_serial": "The charger did not advertise its serial number. It will be offered again on its next advertisement.",
      "not_supported": "This Bluetooth device is not an Easee charger.",
      "reauth_successful": "The new PIN was accepted."
    },
    "error": {
      "cannot_connect": "Could not reach the charger. It must be advertising and in range of a Bluetooth proxy.",
      "invalid_auth": "The charger rejected that PIN.",
      "unknown": "Unexpected error. Check the Home Assistant log."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Easee BLE options",
        "description": "The charger has a single Bluetooth connection slot, and Home Assistant holds it open continuously - that is what makes polling nearly free, and it means the Easee app cannot connect while this integration is running. Disable the integration when you need the app.",
        "data": {
          "scan_interval": "Poll interval (seconds)"
        },
        "data_description": {
          "scan_interval": "How often to read the charger. The link is already up, so a poll costs about 0.4 seconds - short intervals are cheap here."
        }
      }
    }
  },
